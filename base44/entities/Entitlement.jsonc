{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user id this entitlement belongs to"
    },
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "plan": {
      "type": "string",
      "description": "starter / professional / elite / enterprise or an add-on key"
    },
    "kind": {
      "type": "string",
      "enum": [
        "subscription",
        "addon"
      ],
      "default": "subscription"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "past_due",
        "canceled",
        "revoked"
      ],
      "default": "pending"
    },
    "price_id": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "checkout_session_id": {
      "type": "string"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "granted_by": {
      "type": "string",
      "description": "stripe_webhook or admin, never a browser redirect"
    },
    "evidence": {
      "type": "string",
      "description": "Event id and paid status that justified the grant"
    },
    "description": {
      "type": "string",
      "description": "Optional description, up to 1000 characters"
    }
  },
  "required": [
    "user_id",
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}