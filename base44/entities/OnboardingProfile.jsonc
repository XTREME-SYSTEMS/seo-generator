{
  "name": "OnboardingProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "The generated Client project ID"
    },
    "company_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "contact_phone": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    },
    "location_state": {
      "type": "string"
    },
    "location_country": {
      "type": "string",
      "default": "US"
    },
    "industry": {
      "type": "string"
    },
    "sub_industry": {
      "type": "string"
    },
    "service_area": {
      "type": "string",
      "enum": [
        "local",
        "regional",
        "national",
        "international"
      ],
      "default": "local"
    },
    "target_audience": {
      "type": "string",
      "description": "Who the business's customers are"
    },
    "main_services": {
      "type": "string",
      "description": "Primary products or services offered"
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competitor_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_results": {
      "type": "string",
      "description": "What the user wants to achieve (first page Google, more traffic, more leads, etc.)"
    },
    "current_monthly_traffic": {
      "type": "number"
    },
    "monthly_budget": {
      "type": "number"
    },
    "google_search_console_connected": {
      "type": "boolean",
      "default": false
    },
    "google_analytics_connected": {
      "type": "boolean",
      "default": false
    },
    "agent_config": {
      "type": "string",
      "description": "JSON of agent configuration generated from onboarding answers"
    },
    "system_config": {
      "type": "string",
      "description": "JSON of system configuration (industries, strategies, tools enabled)"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "in_progress"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ]
}