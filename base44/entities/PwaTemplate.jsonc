{
  "name": "PwaTemplate",
  "type": "object",
  "properties": {
    "template_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "sub_industry": {
      "type": "string"
    },
    "template_type": {
      "type": "string",
      "enum": [
        "lead_gen",
        "ecommerce",
        "service",
        "marketplace",
        "directory",
        "content",
        "saas"
      ],
      "default": "lead_gen"
    },
    "pwa_enabled": {
      "type": "boolean",
      "default": true
    },
    "offline_support": {
      "type": "boolean",
      "default": true
    },
    "push_notifications": {
      "type": "boolean",
      "default": true
    },
    "installable": {
      "type": "boolean",
      "default": true
    },
    "primary_color": {
      "type": "string",
      "description": "Hex color"
    },
    "accent_color": {
      "type": "string"
    },
    "font_heading": {
      "type": "string"
    },
    "font_body": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Page sections: hero, services, about, testimonials, faq, contact, etc."
    },
    "schema_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "funnel_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Conversion funnel steps"
    },
    "cta_placements": {
      "type": "string"
    },
    "lead_magnet_type": {
      "type": "string"
    },
    "mobile_optimized": {
      "type": "boolean",
      "default": true
    },
    "core_web_vitals_optimized": {
      "type": "boolean",
      "default": true
    },
    "google_guidelines_compliant": {
      "type": "boolean",
      "default": true
    },
    "template_config": {
      "type": "string",
      "description": "JSON config for the template"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ],
      "default": "draft"
    },
    "description": {
      "type": "string",
      "description": "Optional description, up to 1000 characters"
    }
  },
  "required": [
    "template_name",
    "industry"
  ]
}