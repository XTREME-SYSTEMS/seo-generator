{
  "name": "Competitor",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "shared_query_count": {
      "type": "number"
    },
    "measured_wins": {
      "type": "number"
    },
    "measured_losses": {
      "type": "number"
    },
    "authority_signal": {
      "type": "number"
    },
    "authority_provenance": {
      "type": "string",
      "enum": [
        "MEASURED",
        "PROVIDER",
        "INFERRED",
        "MODELED",
        "UNKNOWN"
      ],
      "default": "UNKNOWN"
    },
    "content_velocity": {
      "type": "number"
    },
    "twin_provenance": {
      "type": "string",
      "enum": [
        "MEASURED",
        "PROVIDER",
        "INFERRED",
        "UNKNOWN"
      ],
      "default": "INFERRED"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ]
}