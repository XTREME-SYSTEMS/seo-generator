{
  "name": "RunLedger",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "description": "Hash of function name + actor + payload \u2014 one row per logical operation"
    },
    "function_name": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "succeeded",
        "failed",
        "replayed",
        "blocked_budget"
      ],
      "default": "started"
    },
    "attempt": {
      "type": "number",
      "default": 1
    },
    "duration_ms": {
      "type": "number"
    },
    "llm_calls": {
      "type": "number",
      "default": 0
    },
    "error": {
      "type": "string"
    },
    "result_summary": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "description": "Optional description, up to 1000 characters"
    }
  },
  "required": [
    "idempotency_key",
    "function_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}