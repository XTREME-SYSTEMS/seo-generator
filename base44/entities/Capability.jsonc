{
  "name": "Capability",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "measurement",
        "seo_technical",
        "seo_content",
        "aeo",
        "ai_search",
        "authority",
        "cloud_browser",
        "autonomous",
        "local",
        "ecosystem"
      ],
      "default": "seo_technical"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "implemented",
        "available",
        "requires_credentials",
        "roadmap"
      ],
      "default": "available"
    },
    "implement_function": {
      "type": "string"
    },
    "evidence_tier": {
      "type": "string",
      "default": "T1_CONFIRMED_SYSTEM"
    },
    "automation": {
      "type": "string",
      "enum": [
        "manual",
        "on_demand",
        "scheduled",
        "continuous"
      ],
      "default": "on_demand"
    },
    "impact_score": {
      "type": "number",
      "default": 50,
      "minimum": 0,
      "maximum": 100,
      "description": "Estimated ranking + traffic impact, 0-100"
    },
    "speed_tier": {
      "type": "string",
      "enum": [
        "instant",
        "fast",
        "medium",
        "slow"
      ],
      "default": "medium",
      "description": "How quickly impact manifests after implementation"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "automated",
        "ai_assisted",
        "google_sync",
        "manual"
      ],
      "default": "ai_assisted",
      "description": "How the capability is executed: autonomous loop, AI on demand, direct Google sync, or human"
    },
    "effort_hours": {
      "type": "number",
      "default": 2
    },
    "last_implemented_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "category",
    "name"
  ]
}