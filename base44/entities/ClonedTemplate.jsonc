{
  "name": "ClonedTemplate",
  "type": "object",
  "properties": {
    "niche": {
      "type": "string",
      "description": "The service niche this clone belongs to"
    },
    "source_url": {
      "type": "string",
      "description": "Original website URL that was cloned"
    },
    "site_name": {
      "type": "string"
    },
    "rating": {
      "type": "string",
      "description": "Original site rating e.g. 4.8/5"
    },
    "rank": {
      "type": "number",
      "default": 0,
      "description": "Rank within niche (1 = highest rated)"
    },
    "screenshot_url": {
      "type": "string",
      "description": "Public URL to the full-page screenshot"
    },
    "html_file_url": {
      "type": "string",
      "description": "Public URL to the deterministic self-contained HTML file"
    },
    "design_tokens": {
      "type": "string",
      "description": "JSON-encoded design tokens: colors, fonts, layout structure"
    },
    "visual_parity_score": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100,
      "description": "Deterministic parity score based on actual asset re-hosting"
    },
    "assets_rehosted": {
      "type": "number",
      "default": 0,
      "description": "Number of assets (images, fonts) re-hosted to our storage"
    },
    "is_self_contained": {
      "type": "boolean",
      "default": false,
      "description": "True if >=80% of assets were re-hosted (clone works without original site)"
    },
    "css_inlined": {
      "type": "boolean",
      "default": false,
      "description": "True if external CSS was inlined into the HTML"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superiority_strategy": {
      "type": "string",
      "description": "JSON-encoded strategy to build a superior site"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "cloning",
        "cloned",
        "validated",
        "failed"
      ],
      "default": "queued"
    },
    "clone_error": {
      "type": "string"
    },
    "cloned_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "description": "Optional description, up to 1000 characters"
    }
  },
  "required": [
    "niche",
    "source_url"
  ]
}