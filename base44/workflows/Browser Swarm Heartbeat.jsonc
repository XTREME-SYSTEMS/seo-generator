{
  "name": "Browser Swarm Heartbeat",
  "description": "Hourly heartbeat that picks up queued browser jobs (AgentJob records with kind='browser_job') and dispatches them to the CloudBrowser engine on Railway. Processes up to 5 jobs per cycle to stay within execution limits. Fully autonomous \u2014 no human input required.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "browser_swarm_heartbeat",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_queue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "DispatchBrowserJob",
            "args": {
              "mode": "process_queue",
              "limit": 5
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process Browser Job Queue",
            "description": "Pick up queued browser jobs and dispatch to CloudBrowser engine (max 5 per cycle)"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}