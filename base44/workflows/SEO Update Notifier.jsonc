{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "seo_update_notifier",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_updates": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "NotifySeoUpdates",
            "args": {
              "hours_back": 1,
              "host": "epoxyquotenearme.com"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify Google of SEO Updates",
            "description": "Pings IndexNow + resubmits sitemap to GSC for recently updated pages"
          }
        }
      }
    ]
  },
  "description": "Every 30 minutes, checks for SeoContent title/description updates on epoxyquotenearme.com and notifies Google via IndexNow + GSC sitemap resubmission for faster re-indexing",
  "name": "SEO Update Notifier",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}