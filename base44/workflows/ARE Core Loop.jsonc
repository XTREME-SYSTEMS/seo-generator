{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Autonomous Ranking Engine core loop. Hourly: pull measured Search Console page x query data for every readable property, detect and classify gaps, recommend one concrete evidence-anchored treatment per URL x query, queue the highest-priority ones behind a snapshot, then audit. Nothing is ever marked deployed without a measured on-page change.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "are_core_loop",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "reflect_and_detect": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "AreReflect",
            "args": {}
          },
          "then": "recommend",
          "x-base44": {
            "title": "Reflect + detect gaps",
            "description": "Measured GSC page x query"
          }
        }
      },
      {
        "recommend": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "AreSuggest",
            "args": {
              "surface": "sheet",
              "cycle_id": "${ .reflect_and_detect.cycle_id }"
            }
          },
          "then": "implement",
          "x-base44": {
            "title": "Recommend treatments",
            "description": "One per URL x query"
          }
        }
      },
      {
        "implement": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "AreImplement",
            "args": {
              "cycle_id": "${ .reflect_and_detect.cycle_id }",
              "batch_size": 5
            }
          },
          "then": "settle",
          "x-base44": {
            "title": "Queue behind snapshot",
            "description": "Validated first, never fake-deployed"
          }
        }
      },
      {
        "settle": {
          "wait": "PT3M",
          "then": "audit",
          "x-base44": {
            "title": "Settle",
            "description": "Let changes register"
          }
        }
      },
      {
        "audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "AreAudit",
            "args": {
              "cycle_id": "${ .reflect_and_detect.cycle_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Audit, fix, harden or roll back",
            "description": "Never leave production broken"
          }
        }
      }
    ]
  },
  "name": "ARE Core Loop"
}